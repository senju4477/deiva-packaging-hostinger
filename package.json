{
  "name": "deiva-packaging-hostinger",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "build:preview": "node scripts/build-preview.mjs",
    "admin:hash": "node scripts/admin-hash.mjs",
    "test:ui": "node --import tsx --test tests/ui.test.tsx"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.15.0",
    "next": "16.3.8",
    "nodemailer": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "stripe": "^19.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
